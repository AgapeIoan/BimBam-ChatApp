# Global .gitignore for fullstack (frontend + backend) project

# ======================
# Python / backend
# ======================
__pycache__/
*.py[cod]
*$py.class
*.so

build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.wheel

.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

pip-log.txt
pip-delete-this-directory.txt

htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

target/

# Secrets / local config
.env
.env.*.local
.env.local
.local/
secrets.json
*.pem
*.key
*.crt
*.p12
credentials/
local_settings.py

logs/
*.log
*.sqlite3
*.db

mypy_cache/
.pyre/
dmypy.json
.pytype/

.vagrant/
*.iml

# ======================
# Node / frontend
# ======================
# Node modules (root and any subproject)
node_modules/
**/node_modules/
node_modules
node_modules/**

# Common frontend build caches and outputs
dist/
build/
.tmp/
.cache/
bower_components/
public/build/
.cache-loader/

# Framework-specific
.next/
out/
.nuxt/
.gatsby-cache/
.static/
.parcel-cache/
.svelte-kit/

# Package manager / lock files caches
yarn-error.log*
npm-debug.log*
pnpm-debug.log*
.yarn/*
!.yarn/releases
.pnp.*
.yarnrc.yml

# TypeScript build cache
*.tsbuildinfo

# Frontend temp and artifacts
*.local
.sourcemaps
coverage/

# ======================
# Docker, CI, misc
# ======================
docker-compose.override.yml
docker-compose.*.yml
**/Dockerfile.build

# Editor / IDE
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Backup and temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Misc
.ipynb_checkpoints/
profile_default/
coverage/
*.pid