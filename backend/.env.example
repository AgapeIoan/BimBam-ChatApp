# ========= GLOBAL APP SETTINGS (NO AUTH__ prefix) =========
ENV=development
LOG_LEVEL=DEBUG

# Redis
REDIS_URL=redis://redis:6379/0

# Database (keep whatever your colleague used)
DATABASE__DB_URL=postgresql+asyncpg://postgres_user:postgres_password@db:5432/example_db
DATABASE__DB_HOST=db
DATABASE__DB_PORT=5432
DATABASE__DB_USER=postgres_user
DATABASE__DB_PASSWORD=postgres_password
DATABASE__DB_NAME=example_db

# ========= AUTH SETTINGS (ONLY THESE HAVE AUTH__ prefix) =========
AUTH__GOOGLE_CLIENT_ID=your_google_client_id
AUTH__GOOGLE_CLIENT_SECRET=your_google_client_secret

AUTH__JWT_SECRET_KEY=super_super_secret_key

AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 1 day - in minutes

AUTH__FRONTEND_ORIGIN=http://localhost:5173
